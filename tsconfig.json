{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "checkJs": true,
    "erasableSyntaxOnly": true,
    "plugins": [
      {
        "name": "@astrojs/ts-plugin"
      }
    ]
  }
}
