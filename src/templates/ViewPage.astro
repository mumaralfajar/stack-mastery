---
// Static page shell for a client-rendered view: pre-rendered heading (for SEO and first paint) that the
// view island (src/scripts/view-island.js) replaces with the live view named by `view`.
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkspaceLayout from '../layouts/WorkspaceLayout.astro';
import { jsonForScript, pageStrings } from '../lib/ssr.ts';
import type { Lang } from '../lib/types.ts';

interface Props {
  lang: Lang;
  path: string;
  title: string;
  description: string;
  view: 'dashboard' | 'review' | 'exam' | 'notes' | 'play' | 'interview' | 'break';
  args?: Record<string, string | undefined>;
  eyebrow?: string;
  heading: string;
  lede?: string;
  /** Extra JSON payload for the view (e.g. the dashboard's track catalog). */
  data?: unknown;
  /** Full-bleed page without the study sidebar (break room). */
  fullBleed?: boolean;
  wide?: boolean;
}

const { lang, path, title, description, view, args = {}, eyebrow, heading, lede, data, fullBleed = false, wide = false } = Astro.props;
const { T } = pageStrings(lang);
const payload = data === undefined ? '' : jsonForScript(data);
---
{fullBleed ? (
  <BaseLayout lang={lang} path={path} title={title} description={description} bodyClass="is-landing">
    <div id="app">
      <main id="view" tabindex="-1">
        <div id="view-root" data-view={view} data-args={JSON.stringify(args)} aria-busy="true">
          <div class={'page' + (wide ? ' wide' : '')}>
            <header class="head">
              {eyebrow && <p class="eyebrow">{eyebrow}</p>}
              <h1>{heading}</h1>
              {lede && <p class="lede">{lede}</p>}
            </header>
            <noscript><p class="muted">{T('This page needs JavaScript to run in your browser.')}</p></noscript>
          </div>
        </div>
      </main>
    </div>
    {payload && <script type="application/json" id="view-data" set:html={payload} />}
  </BaseLayout>
) : (
  <WorkspaceLayout lang={lang} path={path} title={title} description={description}>
    <div id="view-root" data-view={view} data-args={JSON.stringify(args)} aria-busy="true">
      <div class={'page' + (wide ? ' wide' : '')}>
        <header class="head">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1>{heading}</h1>
          {lede && <p class="lede">{lede}</p>}
        </header>
        <noscript><p class="muted">{T('This page needs JavaScript to run in your browser.')}</p></noscript>
      </div>
    </div>
    {payload && <script type="application/json" id="view-data" set:html={payload} />}
  </WorkspaceLayout>
)}
<script src="../scripts/view-island.js"></script>
