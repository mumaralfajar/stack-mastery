---
import "../styles/style.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Stack Mastery — C#, ASP.NET Core, SQL, CSS, TypeScript + React, Angular, Dart + Flutter",
  description = "A free, self-paced program from beginner to expert in C#, ASP.NET Core, SQL, CSS + Tailwind, TypeScript + React, Angular, Dart + Flutter, and CS fundamentals — plus full technical interview preparation.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const t = JSON.parse(localStorage.getItem("stackmastery.v1") || "{}").theme;
        if (t === "light" || t === "dark") {
          document.documentElement.dataset.theme = t;
          document.querySelector('meta[name="color-scheme"]').content = t;
        }
      } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/stack-mastery/favicon.svg" />
    <link rel="icon" href="/stack-mastery/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <a class="skip" href="#view" onclick="document.getElementById('view').focus(); return false;">Skip to content</a>
    <div id="app">
      <slot />
    </div>
  </body>
</html>
