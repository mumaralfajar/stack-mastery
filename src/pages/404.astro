---
// Bilingual 404. A legacy `#/...` bookmark that lands here is forwarded to its static page.
import BaseLayout from '../layouts/BaseLayout.astro';
import { LOGO_SVG } from '../lib/icons.ts';
import { routePath } from '../lib/routes.ts';
---
<BaseLayout
  lang="en"
  path="/404.html"
  title="Page not found — Stack Mastery"
  description="This page does not exist. Go back to Stack Mastery in English or Bahasa Indonesia."
  bodyClass="is-landing"
  noindex
  legacyBridge>
  <div id="app">
    <main id="view" tabindex="-1">
      <div class="page not-found">
        <a href={routePath('en', '/')} class="brand"><span class="logo" set:html={LOGO_SVG} />Stack Mastery</a>
        <header class="head">
          <p class="eyebrow">404</p>
          <h1>Page not found</h1>
          <p class="lede">This page does not exist, or it moved when the app switched to real page URLs.</p>
          <p class="lede" lang="id">Halaman ini tidak ada, atau sudah pindah saat aplikasi beralih ke URL halaman sungguhan.</p>
        </header>
        <div class="actions">
          <a class="btn" href={routePath('en', '/')}>Go to the home page</a>
          <a class="btn ghost" href={routePath('id', '/')} lang="id" hreflang="id">Buka beranda (Bahasa Indonesia)</a>
          <a class="btn ghost" href={routePath('en', '/dashboard/')}>Open the dashboard</a>
        </div>
      </div>
    </main>
  </div>
</BaseLayout>
<script src="../scripts/legacy-bridge.ts"></script>
