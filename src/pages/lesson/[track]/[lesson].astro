---
// English route; the page itself lives in src/templates/LessonPage.astro.
import { LESSON_INDEX } from '../../../data/manifest.ts';
import LessonPage from '../../../templates/LessonPage.astro';

export function getStaticPaths() {
  return LESSON_INDEX.map((e) => ({ params: { track: e.trackId, lesson: e.id } }));
}
---
<LessonPage lang="en" trackId={Astro.params.track as string} lessonId={Astro.params.lesson as string} />
