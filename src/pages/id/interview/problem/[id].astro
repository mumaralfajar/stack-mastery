---
// Indonesian route; the page itself lives in src/templates/InterviewPage.astro.
import { getInterview, loadSiteData } from '../../../../data/site.ts';
import InterviewPage from '../../../../templates/InterviewPage.astro';

export async function getStaticPaths() {
  await loadSiteData();
  return (getInterview('en')?.problems ?? []).map((p) => ({ params: { id: p.id } }));
}
---
<InterviewPage lang="id" sub="problem" id={Astro.params.id as string} />
